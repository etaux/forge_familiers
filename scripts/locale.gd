func _ready() -> void:
	code = "en" if str(GameState.language) == "en" else "fr"

func t(key: String) -> String:
	var table: Dictionary = TEXTS.get(code, TEXTS["fr"])
	if table.has(key):
		return str(table[key])
	var fallback: Dictionary = TEXTS["fr"]
	return str(fallback.get(key, key))

func rarity(rarity_id: String) -> String:
	return t("rarity_" + rarity_id)

func is_en() -> bool:
	return code == "en"

func set_code(value: String) -> void:
	var next := "en" if value == "en" else "fr"
	if next == code:
		return
	code = next
	GameState.language = code
	GameState.save_state()
	changed.emit()
